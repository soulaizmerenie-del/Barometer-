# --- Способ 2: чтение под своей учётной записью (barometer collect) ---
# Ключи Telegram-приложения: my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Имя файла сессии Telethon. Первый запуск спросит номер телефона и код.
TELEGRAM_SESSION=barometer

# --- Способ 3: живой сбор ботом (barometer watch) ---
# Токен от @BotFather. Не забудьте /setprivacy → Disable
# и добавить бота во все три рабочих чата.
TELEGRAM_BOT_TOKEN=

# Часовой пояс, в котором считаются сутки отчёта
BAROMETER_TZ=Europe/Podgorica
